{
  "plugins": ["prettier-plugin-solidity"],
  "requirePragma": true,
  "overrides": [
    {
      "files": "*.sol",
      "options": {
        "requirePragma": false,
        "printWidth": 79,
        "tabWidth": 4,
        "singleQuote": false,
        "bracketSpacing": true,
        "endOfLine": "lf"
      }
    }
  ]
}
