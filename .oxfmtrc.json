{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "bracketSpacing": true,
  "semi": false,
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "export/",
    "deployments/",
    "artifacts/",
    "cache/",
    "coverage/",
    "node_modules/",
    "package.json",
    "typechain/",
    "lib/",
    "*.hbs",
    "templates/"
  ]
}
