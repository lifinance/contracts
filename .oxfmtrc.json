{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "bracketSpacing": true,
  "semi": false,
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    // oxfmt also reads .prettierignore, which holds the shared exclusions.
    // Kept byte-identical to main: it has 4 type errors on main (incl. an
    // undefined `lifiDiamondAddress`), so touching it makes validate-scripts
    // fail. Remove once the demo script is fixed.
    "script/demoScripts/demoChainflip.ts"
  ]
}
