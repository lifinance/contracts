{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "bracketSpacing": true,
  "semi": false,
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "*.*",
    "!*.ts",
    "!*.js",
    "export/",
    "deployments/",
    "artifacts/",
    "cache/",
    "coverage/",
    "node_modules/",
    "typechain/",
    "lib/",
    "templates/",
    // Type-broken on main before the oxfmt migration (fails tsc); left unformatted so the
    // validateScripts typecheck of changed files does not flag pre-existing errors.
    "script/demoScripts/demoChainflip.ts"
  ]
}
