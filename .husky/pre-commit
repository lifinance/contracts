#!/usr/bin/env bash
# This hook uses bash-only features (process substitution `< <(...)`, array
# `+=`, `[[ ]]`). husky v8's `.husky/_/husky.sh` re-execs hooks under `sh -e
# "$0"`, which on macOS is bash-in-POSIX-mode — bash-only syntax fails to
# parse inside function bodies, and the error fires AFTER git has already
# accepted the commit, so bad commits slip through silently.
#
# We bypass the broken re-exec by replicating the small bits of husky.sh
# init we actually need (HUSKY=0 skip, ~/.huskyrc) and re-execing under
# `bash -e` instead of `sh -e`.
#
# Compile checks (forge build, TypeChain) are left to pre-push and CI; this hook
# only blocks .env secrets and runs the staged-file formatters and linters.
[ "$HUSKY" = "0" ] && exit 0
if [ -z "$husky_skip_init" ]; then
  readonly husky_skip_init=1
  export husky_skip_init
  # shellcheck source=/dev/null
  [ -f ~/.huskyrc ] && . ~/.huskyrc
  exec bash -e "$0" "$@"
fi

# Early exit: Check if there are any staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No files staged for commit. Skipping pre-commit checks."
  exit 0
fi

GIT_ROOT=$(git rev-parse --show-toplevel)
cd "$GIT_ROOT" || exit 1

# Create temp directory for captured tool output
# Try portable form first, fall back to macOS-specific, then mkdir fallback
TEMP_DIR=$(mktemp -d 2>/dev/null) || TEMP_DIR=$(mktemp -d -t precommit 2>/dev/null) || {
  TEMP_DIR="${TMPDIR:-/tmp}/precommit.$$.$(date +%s).$RANDOM"
  mkdir -p "$TEMP_DIR"
}
trap 'rm -rf "$TEMP_DIR" 2>/dev/null' EXIT INT TERM

LINT_STAGED_OUTPUT="$TEMP_DIR/lint-staged.out"

# Helper function to print section header
print_section() {
  printf '\n\033[1m━━━ %s ━━━\033[0m\n' "$1"
}

# Helper function to print status
print_status() {
  local status=$1
  local message=$2
  if [ "$status" = "success" ]; then
    printf '\033[32m✓\033[0m %s\n' "$message"
  elif [ "$status" = "warning" ]; then
    # Print the full line in yellow (easy to notice)
    printf '\033[33m⚠ %s\033[0m\n' "$message"
  elif [ "$status" = "skip" ]; then
    printf '\033[33m⊘\033[0m %s\n' "$message"
  elif [ "$status" = "error" ]; then
    # Print the full line in red (easy to notice)
    printf '\033[31m✗ %s\033[0m\n' "$message"
  else
    printf '  %s\n' "$message"
  fi
}

# Helper function to colorize lint-staged error output:
# file paths in cyan, errors in red, warnings in yellow
colorize_output() {
  local content=$1

  if [ -z "$content" ]; then
    echo "$content"
    return
  fi

  local ESC=$'\033'
  # Separate -e expressions stand in for newlines, which BSD sed needs inside { }.
  # A line ending in a .sol/.ts/.js/.tsx path is printed in cyan and skips the other rules.
  printf '%s\n' "$content" | sed -E \
    -e '/\.(sol|ts|js|tsx)$/{' \
    -e "s/.*/${ESC}[1;36m&${ESC}[0m/" \
    -e 'b' \
    -e '}' \
    -e "s/([0-9]+:[0-9]+)/${ESC}[33m\1${ESC}[0m/g" \
    -e "s/(^| )(error|Error)( |\$)/\1${ESC}[1;31m\2${ESC}[0m\3/g" \
    -e "s/(^| )(warning|Warning)( |\$)/\1${ESC}[1;33m\2${ESC}[0m\3/g" \
    -e "s/problem/${ESC}[1;31m&${ESC}[0m/g" \
    -e "s/✖/${ESC}[1;31m✖${ESC}[0m/g" \
    -e "s/⚠/${ESC}[1;33m⚠${ESC}[0m/g"
}

# Helper function to filter lint-staged status noise while preserving error context
# Keep: file paths, line numbers, error messages, warnings, problem counts
filter_output() {
  local content=$1

  echo "$content" | grep -vE "\[(STARTED|COMPLETED|SKIPPED|FAILED)\]" | \
    grep -vE "Preparing lint-staged" | \
    grep -vE "Running tasks" | \
    grep -vE "Applying modifications" | \
    grep -vE "Cleaning up" | \
    grep -vE "Reverting to original" | \
    grep -vE "Skipped because" | \
    grep -vE "Hiding unstaged" | \
    grep -vE "Restoring unstaged" | \
    grep -vE "package\.json" | \
    grep -vE "\*\.\{ts,js\}" | \
    grep -vE "\*\.sol" | \
    grep -vE "bash -c" | \
    grep -vE "error: \"lint-staged\"" | \
    grep -vE "A new version of Solhint" | \
    grep -vE "Please consider updating" | \
    grep -vE "===> Join SOLHINT" | \
    grep -vE "^<===" | \
    grep -vE "^---" | \
    grep -vE "^$" | \
    grep -vE "^\[solhint\] Warning:" || true
}

# Helper function to print the filtered output of a failed run
print_failure_output() {
  local output_file=$1

  printf '\n'
  printf '\033[1;31m━━━ lint-staged Error Output ━━━\033[0m\n'
  printf '\n'

  local filtered_output
  filtered_output=$(filter_output "$(cat "$output_file")")
  if [ -n "$filtered_output" ]; then
    colorize_output "$filtered_output"
  else
    # If filtering removed everything, show raw output (might be needed for debugging)
    printf '\033[33mWarning: Filtering removed all output. Showing raw output:\033[0m\n'
    cat "$output_file"
  fi

  printf '\n'
  printf '\033[1;31m━━━ End of lint-staged Error Output ━━━\033[0m\n'
  printf '\n'
}

# Run secret checks early before heavy work
print_status "info" "Checking for secrets and private keys..."
if ! bash "$GIT_ROOT/script/utils/scan-staged-secrets.sh"; then
  exit 1
fi

print_section "Pre-commit Checks"

# Verify foundry binary matches .foundry-version (warn only, do not block commit)
if ! bash "$GIT_ROOT/script/utils/verify-foundry-version.sh" --quiet 2>/dev/null; then
  EXPECTED_FOUNDRY_VERSION=$(tr -d '[:space:]' < "$GIT_ROOT/.foundry-version" 2>/dev/null || echo "unknown")
  ACTUAL_FOUNDRY_VERSION=$(forge --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -1)
  ACTUAL_FOUNDRY_VERSION=${ACTUAL_FOUNDRY_VERSION:-not installed}
  printf '\n\033[1;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'
  printf '\033[1;33m⚠  WARNING: Foundry binary does not match .foundry-version\033[0m\n'
  printf '\033[1;33m   expected: %s\033[0m\n' "$EXPECTED_FOUNDRY_VERSION"
  printf '\033[1;33m   actual:   %s\033[0m\n' "$ACTUAL_FOUNDRY_VERSION"
  printf '\033[1;33m   fix:      foundryup --install %s\033[0m\n' "$EXPECTED_FOUNDRY_VERSION"
  printf '\033[1;33m   Commit will proceed, but please update your local Foundry to match.\033[0m\n'
  printf '\033[1;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'
fi

print_status "info" "Running lint-staged (formatting & linting)..."
LINT_STAGED_STATUS=0
bunx lint-staged > "$LINT_STAGED_OUTPUT" 2>&1 || LINT_STAGED_STATUS=$?
if [ "$LINT_STAGED_STATUS" -ne 0 ]; then
  print_failure_output "$LINT_STAGED_OUTPUT"
  printf '\033[31m%s\033[0m\n\n' "Lint-staged failed. Aborting commit."
  exit 1
fi
print_status "success" "Lint-staged completed"

printf '\n\033[1m━━━ All pre-commit checks passed! ━━━\033[0m\n'
exit 0
